# Ryushi Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - These must be set
# =============================================================================

# FreshRSS connection settings
FRESHRSS_URL=http://freshrss.local
FRESHRSS_USERNAME=your_username
FRESHRSS_PASSWORD=your_password

# AI provider API key (OpenAI or compatible)
RYUSHI_AI_API_KEY=sk-...

# =============================================================================
# OPTIONAL - These have sensible defaults
# =============================================================================

# AI model to use (LiteLLM format, default: gpt-4.1-mini)
# Examples: gpt-4.1-mini, gpt-4o, claude-3-haiku, anthropic/claude-3-sonnet
RYUSHI_AI_MODEL=gpt-4.1-mini

# AI provider base URL (leave empty for OpenAI default)
# Set this for OpenAI-compatible APIs (e.g., Azure, local LLMs)
RYUSHI_AI_BASE_URL=

# External port to expose Ryushi on (default: 8000)
RYUSHI_PORT=8000

# Base URL for generated feed links (e.g., https://ryushi.example.com)
# Leave empty if accessing via localhost
RYUSHI_BASE_URL=
