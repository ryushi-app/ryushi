# Ryushi Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - These must be set
# =============================================================================

# FreshRSS connection settings
FRESHRSS_URL=http://freshrss.local
FRESHRSS_USERNAME=your_username
FRESHRSS_PASSWORD=your_password

# AI provider API key
# Format depends on provider:
#   - OpenAI: sk-...
#   - Mammouth: your-api-key
#   - Others: provider-specific format
RYUSHI_AI_API_KEY=

# =============================================================================
# OPTIONAL - These have sensible defaults
# =============================================================================

# AI model to use (LiteLLM format, default: gpt-4.1-mini)
# Examples:
#   OpenAI: gpt-4.1-mini, gpt-4o, gpt-3.5-turbo
#   Mammouth: mammouth-ai/claude-haiku-4-5
#   Claude: claude-3-haiku, claude-3-sonnet
#   Other: openai/model-name, anthropic/model-name, etc.
RYUSHI_AI_MODEL=gpt-4.1-mini

# AI provider base URL (leave empty for OpenAI default)
# Examples:
#   OpenAI: https://api.openai.com/v1 (default, can be omitted)
#   Mammouth: https://api.mammouth.ai/v1
#   Azure: https://<resource>.openai.azure.com/
#   Local LM Studio: http://localhost:1234/v1
RYUSHI_AI_BASE_URL=

# External port to expose Ryushi on (default: 8000)
RYUSHI_PORT=8000

# Base URL for generated feed links (e.g., https://ryushi.example.com)
# Leave empty if accessing via localhost
RYUSHI_BASE_URL=
