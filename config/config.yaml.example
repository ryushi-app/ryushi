freshrss:
  url: "http://freshrss.local"
  username: "dein_username"
  # password via ENV: RYUSHI_FRESHRSS_PASSWORD

ai:
  model: "gpt-4.1-mini"   # LiteLLM Format (or via ENV: RYUSHI_AI_MODEL)
  # base_url via ENV: RYUSHI_AI_BASE_URL
  # api_key via ENV: RYUSHI_AI_API_KEY
  max_tokens: 2000
  temperature: 0.3

digests:
  categories:
    - name: "Software Engineering"
      schedule: "0 6 * * *"      # täglich 06:00
      max_articles: 50
    - name: "Bücher"
      schedule: "0 8 * * 1"      # montags 08:00
      max_articles: 20

server:
  host: "127.0.0.1"
  port: 8765
