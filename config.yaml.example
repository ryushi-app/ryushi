# Ryushi Scheduler Configuration
#
# This file configures the automatic digest generation schedules and per-category options.
# Copy this file to config.yaml and customize for your setup.
#
# Schedule format: Standard 5-field cron expression
# ┌───────────── minute (0-59)
# │ ┌───────────── hour (0-23)
# │ │ ┌───────────── day of month (1-31)
# │ │ │ ┌───────────── month (1-12)
# │ │ │ │ ┌───────────── day of week (0-6, Sunday=0)
# │ │ │ │ │
# * * * * *

categories:
  # Generate technology digest daily at 6:00 AM (German, uses default prompt)
  technology:
    schedule: "0 6 * * *"
    # Optional: language for digest output (default: German)
    language: "German"
    # Optional: custom system prompt template for digest generation
    # prompt: |
    #   Fasse die folgenden Artikel prägnant in {language} zusammen.
    #   Struktur: ein Einleitungssatz zu den Hauptthemen, dann Stichpunkte pro Artikel.
    # Optional: favicon URL for the feed (relative or absolute URL)
    # favicon: "/static/tech.png"
    # Optional: publish feed to GitHub Gist (requires GITHUB_TOKEN environment variable)
    # gist_enabled: true
    # gist_id: "abc123def456"

  # Generate software engineering digest daily at 7:00 AM
  software-engineering:
    schedule: "0 7 * * *"
    # Example with custom language and favicon
    # language: "English"
    # favicon: "https://cdn.example.com/icons/engineering.png"
    # Example: publish to GitHub Gist
    # gist_enabled: true
    # gist_id: "your-gist-id-here"

  # Generate science digest weekly on Mondays at 8:00 AM using recommendation template
  science:
    schedule: "0 8 * * 1"
    template_type: recommendation              # Use recommendation template instead of digest
    item_type: research-papers                 # Type of items to recommend
    interests:                                 # User interests for filtering
      - Machine Learning
      - Computer Vision
      - Natural Language Processing

  # Example: Book recommendations based on user interests
  # books:
  #   schedule: "0 9 * * *"                    # Daily at 9:00 AM
  #   template_type: recommendation            # Use recommendation template
  #   item_type: books                         # Type of items
  #   interests:                               # User interests
  #     - Science Fiction
  #     - Mystery Novels
  #     - Fantasy
  #   language: "English"

  # Generate news digest twice daily at 6:00 AM and 6:00 PM
  # news:
  #   schedule: "0 6,18 * * *"
  #   language: "German"

# Configuration Options
# ─────────────────────
#
# Each category supports:
#
#   schedule (required):
#     Standard cron expression for when to generate the digest.
#     Example: "0 6 * * *" = daily at 6:00 AM
#
#   language (optional, default: German):
#     Language for digest output. Appears in the system prompt sent to the AI.
#     Common values: "German", "English", "French", "Spanish", etc.
#
#   template_type (optional, default: digest):
#     Type of built-in prompt template to use:
#     - "digest": News digest template with HTML formatting (default)
#     - "recommendation": Personalized recommendations based on interests
#     If both template_type and prompt are specified, prompt takes priority.
#     See docs/prompt-templates.md for detailed template documentation.
#     Example:
#       template_type: recommendation
#
#   item_type (optional):
#     Type of items for recommendation template (e.g., books, movies, papers, articles).
#     Only used with template_type: recommendation or custom prompts that use {item_type}.
#     Example: item_type: "books"
#
#   interests (optional):
#     List of user interests for the recommendation template.
#     Used to filter and rank items based on relevance.
#     Only used with template_type: recommendation or custom prompts that use {interests}.
#     Example:
#       interests:
#         - Science Fiction
#         - Mystery
#
#   prompt (optional):
#     Custom system prompt template for digest generation. Must include {language}
#     placeholder to specify where the language should be inserted.
#     Can also use {item_type} and {interests} placeholders.
#     If not specified, uses the template_type if provided, or default digest template.
#     Takes priority over template_type if both are specified.
#     Example:
#       prompt: |
#         You are a news summarizer. Write a summary in {language}.
#         Keep it concise and structured.
#
#   favicon (optional):
#     URL to the feed icon (favicon) displayed by feed readers.
#     Can be relative (e.g., "/static/icon.png") or absolute (e.g., "https://example.com/icon.png").
#     If not specified, no icon is displayed.
#
#   gist_enabled (optional, default: false):
#     Enable publishing the generated feed to a GitHub Gist.
#     When enabled, the Atom feed XML will be published to the specified Gist after each digest generation.
#     Requires GITHUB_TOKEN environment variable to be set with a valid GitHub token.
#     The Gist is updated (not recreated) on each run, maintaining a stable URL.
#     Example: gist_enabled: true
#
#   gist_id (optional):
#     The GitHub Gist ID where the feed should be published.
#     Required if gist_enabled is true.
#     To obtain a gist_id:
#       1. Create a new Gist on GitHub (https://gist.github.com)
#       2. Copy the ID from the URL (e.g., https://gist.github.com/username/abc123def456 → abc123def456)
#       3. Paste it here
#     The feed will be published to a file named "{category-slug}.atom.xml" in the Gist.
#     Example: gist_id: "abc123def456"
#
# GitHub Token Setup (GITHUB_TOKEN)
# ──────────────────────────────────
#
# To enable Gist publishing, set the GITHUB_TOKEN environment variable with a valid GitHub token:
#
#   export GITHUB_TOKEN="ghp_xxxxxxxxxxxx..."
#   python -m ryushi start
#
# Recommended approach:
#   1. Go to https://github.com/settings/tokens/new
#   2. Create a "Fine-grained personal access token"
#   3. Grant only the "gist" permission scope (under "Account permissions")
#   4. Copy the token and save it as GITHUB_TOKEN environment variable
#
# Security note: Keep your GitHub token secure and never commit it to version control.
# Use environment variables or secret management tools to store it.
#
# Note: Category slugs must match your FreshRSS category names
# (converted to lowercase with spaces replaced by hyphens).
#
# For example:
#   FreshRSS category "Software Engineering" → slug "software-engineering"
#   FreshRSS category "Technology" → slug "technology"
